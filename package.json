{
  "name": "3d-photo-enhancer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc -b",
    "build": "npm run typecheck && vite build",
    "build:production": "npm run build",
    "preview": "vite preview",
    "preview:production": "vite preview --host 127.0.0.1 --port 4173",
    "test": "node --test --experimental-transform-types \"tests/**/*.test.ts\"",
    "verify:build": "node scripts/verify-build.mjs",
    "release:check": "npm test && npm run build && npm run verify:build",
    "smoke:deployment": "node scripts/smoke-deployment.mjs"
  },
  "dependencies": {
    "gifenc": "^1.0.3",
    "vue": "^3.5.18"
  },
  "devDependencies": {
    "@types/node": "^24.2.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.0",
    "vue-tsc": "^3.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
